<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.BomMapper">
    
    <resultMap type="Bom" id="BomResult">
        <result property="bomId"    column="bom_id"    />
        <result property="productId"    column="product_id"    />
        <result property="productName" column="product_name"/>
        <result property="bomCode"    column="bom_code"    />
        <result property="version"    column="version"    />
        <result property="status"    column="status"    />
        <result property="effectiveDate"    column="effective_date"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

<sql id="selectBomVo">

select 
    b.bom_id,
    b.product_id,
    p.product_name,
    b.bom_code,
    b.version,
    b.status,
    b.effective_date,
    b.create_by,
    b.create_time,
    b.update_by,
    b.update_time,
    b.remark

from bom b

left join product p
on b.product_id = p.product_id

</sql>

    <select id="selectBomList" parameterType="Bom" resultMap="BomResult">
        <include refid="selectBomVo"/>
        <where>  
            <if test="productId != null "> and product_id = #{productId}</if>
            <if test="bomCode != null  and bomCode != ''"> and bom_code = #{bomCode}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
        </where>
    </select>
    
    <select id="selectBomByBomId" parameterType="Long" resultMap="BomResult">
        <include refid="selectBomVo"/>
        where bom_id = #{bomId}
    </select>

    <insert id="insertBom" parameterType="Bom" useGeneratedKeys="true" keyProperty="bomId">
        insert into bom
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="productId != null">product_id,</if>
            <if test="bomCode != null and bomCode != ''">bom_code,</if>
            <if test="version != null">version,</if>
            <if test="status != null">status,</if>
            <if test="effectiveDate != null">effective_date,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="productId != null">#{productId},</if>
            <if test="bomCode != null and bomCode != ''">#{bomCode},</if>
            <if test="version != null">#{version},</if>
            <if test="status != null">#{status},</if>
            <if test="effectiveDate != null">#{effectiveDate},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateBom" parameterType="Bom">
        update bom
        <trim prefix="SET" suffixOverrides=",">
            <if test="productId != null">product_id = #{productId},</if>
            <if test="bomCode != null and bomCode != ''">bom_code = #{bomCode},</if>
            <if test="version != null">version = #{version},</if>
            <if test="status != null">status = #{status},</if>
            <if test="effectiveDate != null">effective_date = #{effectiveDate},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where bom_id = #{bomId}
    </update>

    <delete id="deleteBomByBomId" parameterType="Long">
        delete from bom where bom_id = #{bomId}
    </delete>

    <delete id="deleteBomByBomIds" parameterType="String">
        delete from bom where bom_id in 
        <foreach item="bomId" collection="array" open="(" separator="," close=")">
            #{bomId}
        </foreach>
    </delete>

</mapper>